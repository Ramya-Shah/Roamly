# Project Alpha-Forge - sandbox_execution image
#
# Isolated execution environment for AI-generated HFT strategies. This
# container is the ONLY place strategy code ever compiles or runs; it has
# no outbound access to the host, no broker credentials, and (per
# docker-compose.yml) read-only access to historical market data plus a
# hard CPU/memory ceiling to contain runaway or infinite-looping code.

FROM python:3.11-slim-bookworm

WORKDIR /app

# Host compiler toolchain required to build numba/hftbacktest native
# extensions and any pybind11-based components generated strategies might
# pull in.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        gcc \
        g++ \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        numpy \
        pandas \
        numba \
        hftbacktest \
        mcp \
        fastmcp \
        pybind11

# strategy_templates.py and backtest_runner.py are copied alongside
# mcp_server.py because run_backtest launches backtest_runner.py as a
# subprocess, and backtest_runner.py imports strategy_templates.py.
COPY mcp_server.py .
COPY strategy_templates.py .
COPY backtest_runner.py .

EXPOSE 8000

ENTRYPOINT ["python", "mcp_server.py", "--transport", "sse", "--port", "8000"]
