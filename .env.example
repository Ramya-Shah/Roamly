##############################################################################
# Roamly — Root environment template
# This file is for the React Native / Expo client.
# Copy to .env and fill in real values.
# .env is gitignored and must NEVER be committed to version control.
##############################################################################

# --- Backend API URL ----------------------------------------------------------
# The URL your Expo app uses to reach the Fastify backend.
# For local development on device/emulator, use your machine's LAN IP.
# Example: http://192.168.1.100:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# --- Expo EAS (optional, for cloud builds) ------------------------------------
# EXPO_TOKEN=
