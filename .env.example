##############################################################################
# Project Alpha-Forge - environment template
# Copy to .env and fill in real values. .env is loaded automatically by
# docker-compose.yml and must never be committed to version control.
##############################################################################

# --- LLM provider selection -------------------------------------------------
# "openai"    -> uses OPENAI_API_KEY / OPENAI_API_BASE (OpenAI-compatible gateway)
# "anthropic" -> uses ANTHROPIC_API_KEY against the native Anthropic API
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- OpenAI-compatible gateway ----------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Dataset selection --------------------------------------------------------
DATASET_NAME=sample_replay.npz
CALIBRATION_TICKS_FILE=sample_calibration.npz
# Optional held-out out-of-sample replay window (a different day/hour of the
# same market). When set, a strategy that beats the benchmark in-sample must
# also retain at least OOS_MIN_RETENTION_RATIO of that Sharpe out-of-sample,
# or the attempt is rejected as overfit.
VALIDATION_DATASET_NAME=
OOS_MIN_RETENTION_RATIO=0.5
FALLBACK_T=1.0

# --- Sandbox execution limits --------------------------------------------------
# Hard wall-clock limit for one backtest replay inside sandbox_execution.
# Raise this to use larger/longer historical datasets; a bigger dataset means
# more events to replay, which needs more real time even for a correct
# strategy. Lowering it tightens the safety margin against a runaway
# AI-generated strategy at the cost of capping how much data fits.
BACKTEST_TIMEOUT_SECONDS=120
