##############################################################################
# Roamly — Server environment template
# Copy to server/.env and fill in real values.
# server/.env is gitignored and must NEVER be committed to version control.
##############################################################################

# --- Server ------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# --- Database ----------------------------------------------------------------
# For local dev with Docker Compose:
#   DATABASE_URL="postgresql://roamly:roamly_password@localhost:5432/roamly_db?schema=public"
# For local dev without Docker (SQLite fallback):
#   DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://roamly:roamly_password@localhost:5432/roamly_db?schema=public"

# --- Google Gemini AI --------------------------------------------------------
# Get your key at: https://aistudio.google.com/app/apikey
# This key stays strictly on the backend — never exposed to the mobile bundle.
GEMINI_API_KEY=""
