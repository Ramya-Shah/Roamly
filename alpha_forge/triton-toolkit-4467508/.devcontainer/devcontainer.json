{
    "name": "Task Authoring",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
        "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind"
    ],
    "containerEnv": {
        "HOST_WORKSPACE": "${localWorkspaceFolder}",
        "IS_SANDBOX": "1"
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "test -f .env && echo '.env found' || echo 'WARNING: no .env file. Copy .env.example to .env and fill in ANTHROPIC_API_KEY.'",
    "customizations": {}
}
