# Normalize line endings across macOS, Linux, and Windows/WSL checkouts.
# CRLF line endings on shell scripts break their shebang line silently.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
.env* text eol=lf

# Binary formats that must not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.pdf binary
