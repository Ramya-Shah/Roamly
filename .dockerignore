# Keep the build context lean and never ship local-only or secret files.
.env
.env.*
!.env.example
memory_db/*.duckdb
memory_db/*.duckdb.wal
memory_db/*.db
sandbox_workspace/*.py
frontend/node_modules
frontend/dist
**/__pycache__
*.pyc
dist
.git
.agent-memory
# Compose-only Dockerfiles are not used by the single-image build.
Dockerfile.sandbox
Dockerfile.orchestrator
Dockerfile.api
Dockerfile.frontend
